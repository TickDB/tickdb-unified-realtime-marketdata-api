# === TickDB API Key ===
# Required when no per-request X-TickDB-Key header is provided.
# Register at https://tickdb.ai to obtain a key.
# Users can supply their own key per-request via the X-TickDB-Key header,
# which takes priority over this value.
TICKDB_API_KEY=

# === MCP Server Access Control ===
# Optional: protect the MCP endpoint with a Bearer token.
# If set, all MCP clients must include: Authorization: Bearer <token>
# Leave blank for an open server (e.g. behind a private network or VPN).
MCP_ACCESS_TOKEN=

# === Logging ===
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Number of days to retain rotated log files (logs/tickdb_mcp.log.YYYY-MM-DD)
LOG_RETAIN_DAYS=7

# === HTTP Server Settings ===
MCP_TRANSPORT=streamable-http   # or: stdio (for Claude Desktop local use)
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Stateless Streamable HTTP avoids retaining abandoned MCP sessions in memory.
# Set to false only if a future tool needs per-session server state.
MCP_STATELESS_HTTP=true

# Session IDs kept only for lifecycle logs; bounds prevent unbounded memory growth.
MCP_SESSION_LOG_TTL_SECONDS=3600
MCP_SESSION_LOG_MAX_ENTRIES=1000
