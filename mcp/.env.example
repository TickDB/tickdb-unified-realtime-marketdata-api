# === TickDB API Key ===
# Used by stdio, or as an authenticated HTTP fallback when no request key is provided.
# HTTP use of this server key requires MCP_ACCESS_TOKEN and its matching Bearer header.
# Register at https://tickdb.ai to obtain a key.
# Users can supply their own key per-request via the X-TickDB-Key header,
# which takes priority over this value.
TICKDB_API_KEY=

# === MCP Server Access Control ===
# Required for HTTP clients using the server-wide TICKDB_API_KEY.
# If set, all MCP clients must include: Authorization: Bearer <token>
# If blank, HTTP clients must provide their own X-TickDB-Key; server-key fallback
# is rejected with 401, including localhost and reverse-proxy deployments.
# This token does not apply to stdio or the separate OAuth endpoint.
MCP_ACCESS_TOKEN=

# === Logging ===
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Number of days to retain rotated log files (logs/tickdb_mcp.log.YYYY-MM-DD)
LOG_RETAIN_DAYS=7
# Writable log directory, relative to the working directory or an absolute path.
LOG_DIR=logs

# === HTTP Server Settings ===
# Use stdio for Claude Desktop local use.
MCP_TRANSPORT=streamable-http
# Bind to loopback by default. Only expose HTTP deliberately with access controls.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Stateless Streamable HTTP avoids retaining abandoned MCP sessions in memory.
# Set to false only if a future tool needs per-session server state.
MCP_STATELESS_HTTP=true

# Session IDs kept only for lifecycle logs; bounds prevent unbounded memory growth.
MCP_SESSION_LOG_TTL_SECONDS=3600
MCP_SESSION_LOG_MAX_ENTRIES=1000

# Optional /oauth entry point; /mcp and stdio stay unchanged.
OAUTH_ENABLED=false
# HTTPS origin only, e.g. https://mcp.example.com
OAUTH_PUBLIC_URL=
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=
OAUTH_DATABASE_PATH=data/oauth.sqlite3
# Fixed ChatGPT callback for new connections using RFC 9207 issuer identification.
# Existing callback-ID connections may need recreation or their exact URI added here.
OAUTH_REDIRECT_URIS=["https://chatgpt.com/connector_platform_oauth_redirect"]
